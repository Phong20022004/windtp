{
  "name": "windtp",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "WINDTP - ứng dụng học ngoại ngữ, đóng gói thành một file HTML",
  "scripts": {
    "build": "tsx tools/build/build.ts",
    "build:test": "tsx tools/build/build.ts --test-auth --out dist/WINDTP.test.html",
    "typecheck": "tsc --noEmit",
    "test:unit": "node --import tsx --test tests/auth/*.test.ts",
    "test:browser": "npm run build:test && python3 tests/smoke.py && python3 tests/smoke_auth.py",
    "test": "npm run typecheck && npm run test:unit && npm run test:browser",
    "audit": "npm run build:test && python3 tools/audit/audit.py",
    "admin:grant": "tsx tools/admin/set-admin-claim.ts",
    "import:es": "python3 tools/import/import_es.py",
    "import:yonsei": "python3 tools/import/import_yonsei.py"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "firebase": "^11.10.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "firebase-admin": "^14.5.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
